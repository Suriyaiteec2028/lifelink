PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/lifelink
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COOLDOWN_MONTHS=6
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# SMTP Configuration (Optional: fallback logs to console/in-memory log if blank)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM="LifeLink Blood Portal" <notifications@lifelink.local>
